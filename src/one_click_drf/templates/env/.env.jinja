# -------------------------------
# Django settings
# -------------------------------
DEBUG=True
SECRET_KEY=django-insecure-{{ secret_key }}
DATABASE_URL=postgresql://user:password@localhost:5432/{{ project_name }}

ALLOWED_HOSTS=localhost,127.0.0.1,{{ website_domain|default('api.example.com') }},www.{{ website_domain|default('api.example.com') }}
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://{{ website_domain|default('api.example.com') }}




# -------------------------------
# AWS S3 Settings
# -------------------------------
AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_STORAGE_BUCKET_NAME=test-bucket
AWS_S3_REGION_NAME=us-east-1
